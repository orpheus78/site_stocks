# Servidor
PORT=3000
NODE_ENV=development

# Base de dados MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=bar_campo
DB_CONNECTION_LIMIT=10

# Sessao (gerar valor aleatorio longo, ex.: openssl rand -hex 32)
SESSION_SECRET=
SESSION_COOKIE_SECURE=false

# Uploads
UPLOAD_MAX_BYTES=2097152

# Seed (opcional, lido apenas por db/seed.js).
# Definir para nao criar os utilizadores com as credenciais publicas por omissao.
# SEED_ADMIN_USERNAME=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_PIN=
# SEED_BAR_USERNAME=
# SEED_BAR_PASSWORD=
# SEED_BAR_PIN=
