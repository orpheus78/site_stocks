<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0"><i class="bi bi-box-seam" aria-hidden="true"></i> Artigos</h1>
  <a class="btn btn-primary" href="/admin/artigos/novo"><i class="bi bi-plus-lg" aria-hidden="true"></i> Novo artigo</a>
</div>

<div class="row g-2 mb-3 align-items-center">
  <div class="col-auto">
    <form method="get" class="d-flex gap-2">
      <label class="visually-hidden" for="filtroCategoria">Categoria</label>
      <select class="form-select" id="filtroCategoria" name="categoria" onchange="this.form.submit()">
        <option value="">Todas as categorias</option>
        <% categorias.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= categoriaId === c.id ? 'selected' : '' %>><%= c.nome %></option>
        <% }); %>
      </select>
      <noscript><button class="btn btn-outline-primary">Filtrar</button></noscript>
    </form>
  </div>
  <div class="col-sm-4">
    <label class="visually-hidden" for="pesquisaArtigos">Pesquisar artigo</label>
    <input class="form-control" id="pesquisaArtigos" type="search" placeholder="Pesquisar na lista..."
           data-filtra-tabela="tabelaArtigos" autocomplete="off">
  </div>
  <div class="col-auto ms-auto text-body-secondary small"><%= artigos.length %> artigo(s)</div>
</div>

<div class="table-responsive">
  <table class="table table-hover tabela-compacta align-middle" id="tabelaArtigos">
    <thead>
      <tr>
        <th scope="col"><span class="visually-hidden">Imagem</span></th>
        <th scope="col">Nome</th><th scope="col">Categoria</th>
        <th scope="col" class="text-end">Preco</th><th scope="col" class="text-end">Stock</th>
        <th scope="col">Estado</th><th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      <% artigos.forEach(function (a) { %>
        <tr>
          <td>
            <% if (a.imagem) { %>
              <img src="/uploads/<%= a.imagem %>" alt="" class="miniatura">
            <% } else { %>
              <%# Sem imagem: tile com a cor da categoria (nunca imagem partida). %>
              <span class="miniatura-cor" style="background: <%= a.categoria_cor || '#6c757d' %>" aria-hidden="true">
                <%= a.nome.substring(0, 2).toUpperCase() %>
              </span>
            <% } %>
          </td>
          <td class="fw-semibold"><%= a.nome %></td>
          <td>
            <% if (a.categoria_nome) { %>
              <span class="badge" style="background: <%= a.categoria_cor || '#6c757d' %>"><%= a.categoria_nome %></span>
            <% } else { %>
              <span class="text-body-secondary">-</span>
            <% } %>
          </td>
          <td class="text-end"><%= eur(a.preco) %></td>
          <td class="text-end">
            <% if (a.quantidade === null) { %>
              <span class="text-body-secondary">-</span>
            <% } else { %>
              <% var baixo = Number(a.quantidade) <= Number(a.stock_minimo || 0); %>
              <span class="<%= baixo ? 'text-danger fw-bold' : '' %>"><%= Number(a.quantidade) %> <%= a.unidade || 'un' %></span>
            <% } %>
          </td>
          <td><span class="badge text-bg-<%= a.ativo ? 'success' : 'secondary' %>"><%= a.ativo ? 'Ativo' : 'Inativo' %></span></td>
          <td class="text-end text-nowrap">
            <a class="btn btn-outline-secondary btn-sm" href="/admin/artigos/<%= a.id %>/editar"
               aria-label="Editar <%= a.nome %>"><i class="bi bi-pencil" aria-hidden="true"></i> Editar</a>
            <%# Confirmacao pelo modal da aplicacao (/js/confirmar.js): zero JS inline. %>
            <form method="post" action="/admin/artigos/<%= a.id %>/eliminar" class="d-inline"
                  data-confirmar="Eliminar «<%= a.nome %>»?"
                  data-confirmar-titulo="Eliminar artigo"
                  data-confirmar-detalhe="Se ja tiver movimentos, sera apenas desativado."
                  data-confirmar-ok="Eliminar artigo"
                  data-confirmar-perigo="1">
              <button class="btn btn-outline-danger btn-sm" aria-label="Eliminar <%= a.nome %>">
                <i class="bi bi-trash3" aria-hidden="true"></i>
              </button>
            </form>
          </td>
        </tr>
      <% }); %>
      <% if (!artigos.length) { %>
        <tr data-sem-dados="1"><td colspan="7" class="text-body-secondary">Sem artigos para este filtro.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
