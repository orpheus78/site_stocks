<%# Campos conforme validators em routes/categorias.routes.js: nome, cor (#rrggbb), ordem, ativo. %>
<h1 class="h4 mb-3"><%= titulo %></h1>

<form method="post" action="<%= categoria ? '/admin/categorias/' + categoria.id : '/admin/categorias' %>" class="row g-3" style="max-width: 640px;">
  <div class="col-12">
    <label class="form-label" for="nome">Nome</label>
    <input class="form-control form-control-lg" id="nome" name="nome" maxlength="80" required
           autofocus value="<%= categoria ? categoria.nome : '' %>">
  </div>

  <div class="col-6">
    <label class="form-label" for="cor">Cor no ecra de registo</label>
    <input type="color" class="form-control form-control-color form-control-lg" id="cor" name="cor"
           value="<%= categoria ? categoria.cor : '#0d6efd' %>" title="Cor dos botoes desta categoria">
  </div>

  <div class="col-6">
    <label class="form-label" for="ordem">Ordem</label>
    <input type="number" min="0" class="form-control form-control-lg" id="ordem" name="ordem"
           value="<%= categoria ? categoria.ordem : 0 %>">
    <div class="form-text">Menor numero aparece primeiro no ecra de registo (GIM).</div>
  </div>

  <div class="col-12">
    <div class="form-check form-switch">
      <input type="checkbox" class="form-check-input" id="ativo" name="ativo" value="1"
             <%= !categoria || categoria.ativo ? 'checked' : '' %>>
      <label class="form-check-label" for="ativo">Ativa (visivel no Resgisto)</label>
    </div>
  </div>

  <div class="col-12 d-flex gap-2">
    <button class="btn btn-primary btn-toque px-4" type="submit"><i class="bi bi-check-lg" aria-hidden="true"></i> Guardar</button>
    <a class="btn btn-outline-secondary btn-toque px-4" href="/admin/categorias">Cancelar</a>
  </div>
</form>
