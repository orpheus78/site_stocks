<div class="row justify-content-center align-items-center" style="min-height: 90vh;">
  <div class="col-12 col-sm-10 col-md-6 col-lg-4">

    <div class="text-center mb-4">
      <i class="bi bi-cup-hot display-4 text-primary"></i>
      <h1 class="h3 mt-2"><%= appNome %></h1>
      <p class="text-body-secondary mb-0">Gestao de bar do campo de futebol</p>
    </div>

    <% if (erro) { %>
      <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= erro %></div>
    <% } %>

    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="h6 text-uppercase text-body-secondary mb-3">Entrar com utilizador</h2>
        <form method="post" action="/login" autocomplete="off">
          <input type="hidden" name="next" value="<%= next %>">
          <div class="mb-3">
            <label class="form-label" for="username">Utilizador</label>
            <input class="form-control form-control-lg" id="username" name="username" required autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input type="password" class="form-control form-control-lg" id="password" name="password" required>
          </div>
          <button class="btn btn-primary btn-lg w-100" type="submit">
            <i class="bi bi-box-arrow-in-right"></i> Entrar
          </button>
        </form>
      </div>
    </div>

    <div class="card shadow-sm mt-3">
      <div class="card-body">
        <h2 class="h6 text-uppercase text-body-secondary mb-3">Entrada rapida por PIN</h2>

        <%#
          Sem JavaScript ve-se apenas o campo (mascarado) e o botao Entrar.
          Os pontos e o teclado nascem com `hidden` e so o /js/pin-teclado.js os
          revela — degradacao sem ecra partido. O PIN nunca aparece em claro.
        %>
        <form method="post" action="/gim/pin" autocomplete="off" data-pin-teclado>
          <div class="pin-pontos mb-3" hidden data-pin-pontos>
            <span class="pin-ponto" data-pin-ponto></span>
            <span class="pin-ponto" data-pin-ponto></span>
            <span class="pin-ponto" data-pin-ponto></span>
            <span class="pin-ponto" data-pin-ponto></span>
          </div>

          <input type="password" class="form-control form-control-lg text-center mb-3"
                 name="pin" inputmode="numeric" pattern="[0-9]{4}" maxlength="4"
                 placeholder="••••" required autocomplete="off"
                 aria-label="PIN de 4 digitos" data-pin-campo>

          <div class="pin-teclado mb-3" hidden data-pin-grelha>
            <button type="button" class="pin-tecla" data-pin-tecla="1">1</button>
            <button type="button" class="pin-tecla" data-pin-tecla="2">2</button>
            <button type="button" class="pin-tecla" data-pin-tecla="3">3</button>
            <button type="button" class="pin-tecla" data-pin-tecla="4">4</button>
            <button type="button" class="pin-tecla" data-pin-tecla="5">5</button>
            <button type="button" class="pin-tecla" data-pin-tecla="6">6</button>
            <button type="button" class="pin-tecla" data-pin-tecla="7">7</button>
            <button type="button" class="pin-tecla" data-pin-tecla="8">8</button>
            <button type="button" class="pin-tecla" data-pin-tecla="9">9</button>
            <button type="button" class="pin-tecla pin-tecla-apagar" data-pin-tecla="apagar"
                    aria-label="Apagar o ultimo digito"><i class="bi bi-backspace"></i></button>
            <button type="button" class="pin-tecla" data-pin-tecla="0">0</button>
            <button type="button" class="pin-tecla pin-tecla-limpar" data-pin-tecla="limpar"
                    aria-label="Limpar o PIN">C</button>
          </div>

          <p class="form-text mb-2" role="status" aria-live="polite" data-pin-estado></p>

          <button class="btn btn-success btn-lg w-100 btn-toque" type="submit">
            <i class="bi bi-box-arrow-in-right"></i> Entrar
          </button>
        </form>
        <p class="form-text mb-0">Vai directamente para o ecra de Movimentos Internos.</p>
      </div>
    </div>

  </div>
</div>
