<div class="text-center py-5">
  <i class="bi bi-exclamation-octagon display-1 text-danger"></i>
  <h1 class="h3 mt-3"><%= typeof status !== 'undefined' ? status : 500 %> · <%= titulo %></h1>
  <p class="lead"><%= typeof mensagem !== 'undefined' ? mensagem : 'Ocorreu um erro.' %></p>
  <% if (typeof detalhe !== 'undefined' && detalhe) { %>
    <pre class="text-start small bg-body-secondary p-3 rounded mx-auto" style="max-width: 900px; overflow:auto;"><%= detalhe %></pre>
  <% } %>
  <a class="btn btn-primary" href="/pos"><i class="bi bi-house"></i> Voltar</a>
</div>
