<%#
  Ecra de MOVIMENTOS INTERNOS — GIM — desenhado para ecra touch atras
  do balcao. Nao ha dinheiro: regista-se o consumo de artigos e o respetivo
  total, sem metodo de pagamento, sem valor recebido e sem troco.
  API: GET /api/gim/artigos | POST /api/consumos
  Logica em /js/gim.js, estilos em /css/gim.css.
%>
<div class="gim" id="gim">

  <!-- Barra superior discreta: botoes pequenos para nao serem tocados por engano. -->
  <header class="gim-topo">
    <div class="gim-topo-info">
      <span class="gim-topo-marca"><i class="bi bi-cup-hot" aria-hidden="true"></i> <%= appNome %></span>
      <% if (utilizador) { %>
        <span class="gim-topo-operador"><i class="bi bi-person" aria-hidden="true"></i> <%= utilizador.nome %></span>
      <% } %>
      <span class="gim-topo-relogio" id="gimRelogio" aria-hidden="true"></span>
    </div>

    <div class="gim-topo-acoes">
      <%# Consulta do proprio turno: disponivel a qualquer operador. O filtro
          por utilizador e imposto no SERVIDOR (ver meusMovimentos.controller). %>
      <a class="gim-mini-btn" href="/gim/meus-movimentos" aria-label="Ver os meus movimentos">
        <i class="bi bi-clipboard-check" aria-hidden="true"></i><span>Os meus movimentos</span>
      </a>
      <%# Caixa e backoffice so existem para o admin; o funcionario apenas regista movimentos. %>
      <% if (isAdmin) { %>
        <a class="gim-mini-btn" href="/caixa" aria-label="Ir para a caixa"><i class="bi bi-cash-coin" aria-hidden="true"></i><span>Caixa</span></a>
        <a class="gim-mini-btn" href="/admin" aria-label="Ir para o backoffice"><i class="bi bi-speedometer2" aria-hidden="true"></i><span>Gestao</span></a>
      <% } %>
      <%# Confirmacao pelo painel escuro do GIM (/js/confirmar.js): zero JS inline. %>
      <form method="post" action="/logout" class="d-inline"
            data-confirmar="Terminar sessao?"
            data-confirmar-titulo="Terminar sessao"
            data-confirmar-detalhe="O ecra volta ao inicio de sessao. Sera preciso entrar outra vez para registar movimentos."
            data-confirmar-ok="Terminar sessao"
            data-confirmar-cancelar="Continuar aqui"
            data-confirmar-perigo="1">
        <button class="gim-mini-btn gim-mini-btn-sair" type="submit" aria-label="Terminar sessao">
          <i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Sair</span>
        </button>
      </form>
    </div>
  </header>

  <%#
    Aviso de caixa fechada. O registo NAO fica bloqueado, mas como os
    movimentos internos contam para o dinheiro esperado em caixa, um movimento
    registado agora fica fora de qualquer fecho. Faixa fina, fora da area de
    toque do catalogo e do carrinho, para nao estragar o layout touch.
  %>
  <% if (typeof caixaAberta !== 'undefined' && !caixaAberta) { %>
    <div class="gim-aviso-caixa" role="status">
      <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
      <span>Nao ha caixa aberta — os movimentos ficam fora do fecho.</span>
      <% if (isAdmin) { %>
        <a class="gim-aviso-caixa-btn" href="/caixa">Abrir caixa</a>
      <% } else { %>
        <strong>Avise o responsavel.</strong>
      <% } %>
    </div>
  <% } %>

  <div class="gim-corpo">

    <!-- COLUNA ESQUERDA: categorias + artigos -->
    <section class="gim-catalogo" aria-label="Catalogo de artigos">
      <div class="gim-filtros">
        <div class="gim-categorias" id="gimCategorias" role="group" aria-label="Filtrar por categoria"></div>
        <div class="gim-pesquisa">
          <label class="visually-hidden" for="gimPesquisa">Pesquisar artigo</label>
          <i class="bi bi-search" aria-hidden="true"></i>
          <input type="search" id="gimPesquisa" class="gim-pesquisa-input" placeholder="Pesquisar..."
                 autocomplete="off" enterkeyhint="search">
          <button type="button" class="gim-pesquisa-limpar" id="gimPesquisaLimpar" aria-label="Limpar pesquisa" hidden>
            <i class="bi bi-x-lg" aria-hidden="true"></i>
          </button>
        </div>

        <%#
          Contador de artigos abaixo do stock minimo. Fica escondido enquanto
          nao houver nenhum, para nao ocupar espaco a toa no balcao.
          Preenchido por /js/gim.js a partir de GET /api/gim/artigos.
        %>
        <button type="button" class="gim-falta-btn" id="gimFaltaBtn" hidden
                aria-haspopup="dialog" aria-controls="gimFaltaPainel">
          <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
          <span id="gimFaltaTexto">0 artigos em falta</span>
        </button>
      </div>

      <div class="gim-grelha" id="gimGrelha"></div>

      <div class="gim-estado" id="gimEstado" aria-live="polite">
        <div class="spinner-border" role="status"><span class="visually-hidden">A carregar...</span></div>
        <p>A carregar artigos...</p>
      </div>
    </section>

    <!-- COLUNA DIREITA: carrinho fixo -->
    <aside class="gim-carrinho" aria-label="Artigos do movimento">
      <div class="gim-carrinho-topo">
        <h1 class="gim-carrinho-titulo"><i class="bi bi-basket2" aria-hidden="true"></i> Movimentos Internos</h1>
        <button type="button" class="gim-limpar" id="gimLimpar" aria-label="Limpar lista" disabled>
          <i class="bi bi-trash3" aria-hidden="true"></i>
        </button>
      </div>

      <ul class="gim-linhas" id="gimLinhas"></ul>

      <p class="gim-carrinho-vazio" id="gimCarrinhoVazio">
        <i class="bi bi-hand-index-thumb" aria-hidden="true"></i>
        Toque num artigo para o adicionar.
      </p>

      <div class="gim-carrinho-rodape">
        <div class="gim-total-linha">
          <span class="gim-total-etiqueta">TOTAL</span>
          <span class="gim-total-valor" id="gimTotal">0,00 €</span>
        </div>
        <div class="gim-total-artigos" id="gimContagem">0 artigos</div>
        <button type="button" class="gim-registar" id="gimRegistar" disabled>
          <i class="bi bi-check2-circle" aria-hidden="true"></i> Registar
        </button>
      </div>
    </aside>
  </div>

  <%#
    CONFIRMACAO DO MOVIMENTO (ecra inteiro)
    Nao ha dinheiro: so se confirma o total do consumo antes de gravar.
  %>
  <div class="gim-modal" id="gimModalMovimento" role="dialog" aria-modal="true"
       aria-labelledby="gimModalTitulo" hidden>
    <div class="gim-modal-cabecalho">
      <h2 class="gim-modal-titulo" id="gimModalTitulo">Movimento</h2>
      <div class="gim-modal-total">
        <span>Total do movimento</span>
        <strong id="gimModalTotal">0,00 €</strong>
      </div>
      <button type="button" class="gim-modal-fechar" id="gimModalFechar" aria-label="Cancelar movimento">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </div>

    <div class="gim-modal-corpo">
      <p class="gim-modal-ajuda">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        Registo de consumo interno: nao ha cobranca nem documento — sem valor fiscal.
        Confirme para gravar o movimento e o desconto de stock.
      </p>

      <ul class="gim-resumo" id="gimResumo" aria-label="Resumo do movimento"></ul>

      <p class="gim-movimento-erro" id="gimMovimentoErro" role="alert" hidden></p>
    </div>

    <div class="gim-modal-rodape">
      <button type="button" class="gim-btn-cancelar" id="gimCancelar">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar
      </button>
      <button type="button" class="gim-btn-confirmar" id="gimConfirmar">
        <i class="bi bi-check-lg" aria-hidden="true"></i> CONFIRMAR
      </button>
    </div>
  </div>

  <!-- ECRA DE SUCESSO -->
  <div class="gim-sucesso" id="gimSucesso" role="dialog" aria-modal="true" aria-labelledby="gimSucessoTitulo" hidden>
    <div class="gim-sucesso-caixa">
      <i class="bi bi-check-circle-fill gim-sucesso-icone" aria-hidden="true"></i>
      <h2 class="gim-sucesso-titulo" id="gimSucessoTitulo">Movimento registado</h2>
      <p class="gim-sucesso-numero" id="gimSucessoNumero"></p>

      <div class="gim-sucesso-acoes">
        <button type="button" class="gim-sucesso-nova" id="gimSucessoNova">
          <i class="bi bi-arrow-repeat" aria-hidden="true"></i> NOVO MOVIMENTO
        </button>
      </div>
    </div>
  </div>

  <%#
    PAINEL DE ARTIGOS EM FALTA
    Lista os artigos abaixo do stock minimo, dos mais criticos para os menos.
    E so informacao: nao ha aqui nenhuma accao de gestao nem link para /admin
    (o funcionario nao tem acesso ao backoffice — so avisa o responsavel).
    A lista e construida em /js/gim.js com createElement/textContent.
  %>
  <div class="gim-falta" id="gimFaltaPainel" role="dialog" aria-modal="true"
       aria-labelledby="gimFaltaTitulo" hidden>
    <div class="gim-falta-caixa">
      <h2 class="gim-falta-titulo" id="gimFaltaTitulo">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Artigos em falta
      </h2>
      <p class="gim-falta-ajuda">Avise o responsavel para repor estes artigos.</p>

      <ul class="gim-falta-lista" id="gimFaltaLista"></ul>

      <button type="button" class="gim-falta-fechar" id="gimFaltaFechar">
        <i class="bi bi-check-lg" aria-hidden="true"></i> FECHAR
      </button>
    </div>
  </div>

  <!-- Zona de toasts -->
  <div class="gim-toasts" id="gimToasts" aria-live="polite" aria-atomic="true"></div>
</div>
