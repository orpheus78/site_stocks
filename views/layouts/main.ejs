<!doctype html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' + appNome : appNome %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
  <%# Folhas de estilo especificas da pagina (caminhos definidos no controller, nunca input do utilizador). %>
  <% (typeof estilos !== 'undefined' && Array.isArray(estilos) ? estilos : []).forEach(function (href) { %>
    <link href="<%= href %>" rel="stylesheet">
  <% }); %>
</head>
<body class="bg-body-tertiary<%= typeof bodyClass !== 'undefined' && bodyClass ? ' ' + bodyClass : '' %>">

<% if (!(typeof layoutSemNav !== 'undefined' && layoutSemNav)) { %>
  <%- include('../partials/navbar') %>
<% } %>

<main class="container-fluid py-3">
  <%- include('../partials/flash') %>
  <%- body %>
</main>

<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<%# Logica pura dos campos de valor (virgula pt-PT). Tem de vir antes de app.js. %>
<script src="/js/valor-decimal.js"></script>
<%# Modal de confirmacao da aplicacao (substitui os confirm()/alert() nativos).
    Tem de vir antes de app.js e de /js/gim.js, que o usam. %>
<script src="/js/confirmar.js"></script>
<script src="/js/app.js"></script>
<%# Scripts especificos da pagina (caminhos definidos no controller). %>
<% (typeof scripts !== 'undefined' && Array.isArray(scripts) ? scripts : []).forEach(function (src) { %>
  <script src="<%= src %>" defer></script>
<% }); %>
</body>
</html>
